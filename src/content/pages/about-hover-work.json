multidisciplinary background spanning painting, photography, video, sculpture, and visual composition, I bring an artistic perspective to the world of digital design.","style":{"family":"Darker Grotesque","weight":700,"size":36,"color":"#f9f6f2"}}]},{"id":"116:96","name":"I believe great design happens at the intersection of creativity, strategy, and technology. Where thoughtful solutions meet distinctive visual identities and meaningful user experiences.","x":588,"y":2813,"w":707,"h":209,"k":"text","align":"RIGHT","valign":"TOP","resize":"NONE","runs":[{"text":"I believe great design happens at the intersection of creativity, strategy, and technology. Where thoughtful solutions meet distinctive visual identities and meaningful user experiences.","style":{"family":"Darker Grotesque","weight":700,"size":32,"color":"#f9f6f2"}}]},{"id":"116:97","name":"I don't just design how things look. I care about how they work, what they communicate, and how they make people feel.","x":279,"y":3110,"w":960,"h":108,"k":"text","align":"LEFT","valign":"TOP","resize":"NONE","runs":[{"text":"I don't just design how things look. I care about how they work, what they communicate, and how they make people feel.","style":{"family":"Darker Grotesque","weight":700,"size":40,"color":"#f9f6f2"}}]},{"id":"116:98","name":"image 37","x":868,"y":1473,"w":522,"h":535,"image":{"src":"/images/figma/13c3b0f8beabf4dd1476aaba235992b596780fa4.png","mode":"CROP","opacity":1,"crop":[0.95752,0,0,0,0.55175,0.21974]},"k":"box"},{"id":"116:99","name":"Today, I combine this creative foundation with UX/UI Design and Brand Strategy to build digital experiences that go beyond functionality and aesthetics. I'm interested in understanding what makes a product meaningful: the people behind it, their needs, the identity of a brand, and the stories it communicates.","x":593,"y":2345,"w":705,"h":301,"k":"text","align":"LEFT","valign":"TOP","resize":"HEIGHT","runs":[{"text":"Today, I combine this creative foundation with UX/UI Design and Brand Strategy to build digital experiences that go beyond functionality and aesthetics.\n\nI'm interested in understanding what makes a product meaningful: the people behind it, their needs, the identity of a brand, and the stories it communicates.","style":{"family":"Darker Grotesque","weight":400,"size":32,"color":"#141414"}}]},{"id":"116:100","name":"about","x":130,"y":1434,"w":680,"h":39,"k":"text","align":"LEFT","valign":"TOP","resize":"HEIGHT","runs":[{"text":"about","style":{"family":"Notable","weight":400,"size":40,"lh":38.6,"ls":4.4,"color":"#ffffff"}}]},{"id":"116:101","name":"Hi there!","x":734,"y":316,"w":660,"h":186,"k":"text","align":"LEFT","valign":"TOP","resize":"HEIGHT","runs":[{"text":"Hi there!","style":{"family":"Notable","weight":400,"size":96,"lh":92.64,"ls":10.56,"color":"#000000"}}]},{"id":"116:102","name":"Line 45","x":690,"y":338,"w":164,"m":[0,1,-1,0],"k":"line","weight":3,"color":"#000000"},{"id":"116:103","name":"Line 46","x":1289,"y":686,"w":182,"m":[0,1,-1,0],"k":"line","weight":2,"color":"#000000"},{"id":"116:104","name":"Ellipse 147","x":-77,"y":599,"w":253,"h":232,"bg":"#000000","radius":"50%","k":"box"},{"id":"116:105","name":"Line 47","x":130,"y":1528,"w":435,"m":[0.0046,0.99999,-0.99999,0.0046],"k":"line","weight":2,"color":"#ffffff"},{"id":"116:106","name":"image 75","x":66,"y":2260,"w":471,"h":696,"image":{"src":"/images/figma/1049f0cb8334ed63cc41443aa4098c45b3e92e43.png","mode":"CROP","opacity":1,"crop":[0.7029,0,0.2969,0,1,0]},"radius":60,"shadow":[{"inset":false,"x":1,"y":4,"blur":8.8,"spread":0,"color":"rgb(0 0 0 / 0.25)"}],"k":"box"},{"id":"116:107","name":"Line 48","x":492,"y":2465,"w":557,"m":[0,1,-1,0],"k":"line","weight":2,"color":"#ffffff"},{"id":"116:108","name":"Rectangle 296","x":66,"y":2594,"w":33,"h":290,"bg":"#e3dcd5","k":"box"},{"id":"116:109","name":"Rectangle 297","x":89,"y":2838,"w":46,"h":40,"bg":"#e5dfd8","k":"box"},{"id":"116:110","name":"Ellipse 148","x":503,"y":2717,"w":115,"h":167,"b